; Disegna un glifo ROM alla posizione indicata
;
; Indirizzo font=$3C00+8*A. Legge otto righe e le combina tramite maschere con
; uno o due byte dello schermo. INC H passa alla riga pixel seguente. Alla fine
; HL/C avanzano di SETTE pixel, non otto. Preserva A, B e DE; modifica i flag.
; Non invoca la routine PRINT della ROM.
;
; A Codice carattere.
; HL Indirizzo bitmap della prima riga del glifo.
; C Offset orizzontale in bit (0-7).
c$C388 PUSH AF       ;
 $C389 PUSH BC       ;
 $C38A PUSH DE       ;
 $C38B PUSH HL       ;
 $C38C LD L,A        ; {Calcola 8*A.
 $C38D LD H,$00      ;
 $C38F ADD HL,HL     ;
 $C390 ADD HL,HL     ;
 $C391 ADD HL,HL     ; }
 $C392 LD DE,$3C00   ; {Base per la tabella caratteri ROM.
 $C395 ADD HL,DE     ;
 $C396 EX DE,HL      ;
 $C397 POP HL        ;
 $C398 PUSH HL       ; }
 $C399 LD B,$08      ; Otto righe per glifo.
*$C39B LD A,(DE)     ; {Allinea e unisce la prima porzione di riga al byte
 $C39C PUSH BC       ; video.
 $C39D PUSH AF       ;
 $C39E DEC C         ;
 $C39F INC C         ;
 $C3A0 LD B,$FF      ;
 $C3A2 JR Z,$C3AB    ;
*$C3A4 SRL A         ;
 $C3A6 SRL B         ;
 $C3A8 DEC C         ;
 $C3A9 JR NZ,$C3A4   ;
*$C3AB LD C,A        ;
 $C3AC LD A,B        ;
 $C3AD CPL           ;
 $C3AE AND (HL)      ;
 $C3AF OR C          ;
 $C3B0 LD (HL),A     ;
 $C3B1 POP AF        ;
 $C3B2 POP BC        ; }
 $C3B3 DEC C         ; {Se C non e zero, unisce anche la porzione nel byte
 $C3B4 INC C         ; successivo.
 $C3B5 JR Z,$C3D0    ;
 $C3B7 PUSH BC       ;
 $C3B8 PUSH AF       ;
 $C3B9 LD A,$08      ;
 $C3BB SUB C         ;
 $C3BC LD C,A        ;
 $C3BD POP AF        ;
 $C3BE LD B,$FF      ;
*$C3C0 SLA A         ;
 $C3C2 SLA B         ;
 $C3C4 DEC C         ;
 $C3C5 JR NZ,$C3C0   ;
 $C3C7 LD C,A        ;
 $C3C8 LD A,B        ;
 $C3C9 CPL           ;
 $C3CA INC HL        ;
 $C3CB AND (HL)      ;
 $C3CC OR C          ;
 $C3CD LD (HL),A     ;
 $C3CE DEC HL        ;
 $C3CF POP BC        ;
*$C3D0 INC DE        ;
 $C3D1 INC H         ;
 $C3D2 DJNZ $C39B    ;
 $C3D4 POP HL        ;
 $C3D5 POP DE        ;
 $C3D6 POP BC        ; }
 $C3D7 LD A,C        ; {Avanzamento orizzontale di sette pixel.
 $C3D8 ADD A,$07     ;
 $C3DA CP $08        ;
 $C3DC JR C,$C3E1    ;
 $C3DE SUB $08       ;
 $C3E0 INC L         ;
*$C3E1 LD C,A        ;
 $C3E2 POP AF        ;
 $C3E3 RET           ; }

