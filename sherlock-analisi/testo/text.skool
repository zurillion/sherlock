; Indice alfabetico e limite dell'area dizionario
;
; Word little-endian. Il decoder usa le entrate a partire dal codice $60; a-z
; corrispondono a $5D82-$5DB5. I valori sono offset relativi a $5DBF. La word a
; $5DBE contiene $09F8, che conduce a $67B7.
w$5D80 DEFW $0000
 $5D82 DEFW $0001
 $5D84 DEFW $00A7
 $5D86 DEFW $0164
 $5D88 DEFW $020D
 $5D8A DEFW $0280
 $5D8C DEFW $02DD
 $5D8E DEFW $036A
 $5D90 DEFW $03BA
 $5D92 DEFW $042D
 $5D94 DEFW $048B
 $5D96 DEFW $0494
 $5D98 DEFW $04B0
 $5D9A DEFW $0532
 $5D9C DEFW $0599
 $5D9E DEFW $05E8
 $5DA0 DEFW $0636
 $5DA2 DEFW $06EB
 $5DA4 DEFW $06F9
 $5DA6 DEFW $075A
 $5DA8 DEFW $0882
 $5DAA DEFW $090C
 $5DAC DEFW $094B
 $5DAE DEFW $095A
 $5DB0 DEFW $09DF
 $5DB2 DEFW $09E3
 $5DB4 DEFW $09F5
 $5DB6 DEFW $0000
 $5DB8 DEFW $0000
 $5DBA DEFW $0000
 $5DBC DEFW $0000
 $5DBE DEFW $09F8

i$5DC0

; Tabella delle 32 parole frequenti
;
; I token $60-$7F selezionano una word a questa base. Il risultato e un offset
; nel dizionario; $A840 aggiunge il contesto $5000, cioe senza suffisso.
w$67B7 DEFW $089D
 $67B9 DEFW $08DB
 $67BB DEFW $0001
 $67BD DEFW $005D
 $67BF DEFW $09EE
 $67C1 DEFW $05EC
 $67C3 DEFW $0899
 $67C5 DEFW $0485
 $67C7 DEFW $0450
 $67C9 DEFW $096A
 $67CB DEFW $009A
 $67CD DEFW $042D
 $67CF DEFW $0488
 $67D1 DEFW $05D5
 $67D3 DEFW $03DF
 $67D5 DEFW $0263
 $67D7 DEFW $0986
 $67D9 DEFW $094B
 $67DB DEFW $09BF
 $67DD DEFW $03FC
 $67DF DEFW $0794
 $67E1 DEFW $015E
 $67E3 DEFW $03E3
 $67E5 DEFW $05FF
 $67E7 DEFW $007A
 $67E9 DEFW $0620
 $67EB DEFW $0351
 $67ED DEFW $05E0
 $67EF DEFW $00C0
 $67F1 DEFW $0996
 $67F3 DEFW $0414
 $67F5 DEFW $0594

i$67F7

; Frase verificata: I do not know the word seguito da virgoletta
;
; Eseguita in isolamento con il codice Z80 originale e stampa bitmap reale. Non
; sono istruzioni CPU: e il linguaggio dei testi interpretato da $A5CD.
b$6859 DEFB $6B,$6F,$6D     ; Token frequenti: i, do, not.
 $685C DEFB $D4,$AD         ; Token lungo: contesto $50, offset $4AD = know.
 $685E DEFB $60             ; Token frequente: the.
 $685F DEFB $20             ; Spazio letterale.
 $6860 DEFB $43,$BB,$E4,$40 ; Conteggio $43: quattro caratteri a 5 bit; $BB $E4
                            ; $40 = word.
 $6864 DEFB $22             ; Virgoletta letterale.
 $6865 DEFB $1F             ; Comando $1F: termina senza punto o ritorno a
                            ; capo.

i$6866

; Tabella dispatch dei 32 comandi del linguaggio dei testi
w$A55D DEFW $A65D
 $A55F DEFW $A66C
 $A561 DEFW $A679
 $A563 DEFW $A702
 $A565 DEFW $A709
 $A567 DEFW $A711
 $A569 DEFW $A720
 $A56B DEFW $A72C
 $A56D DEFW $A736
 $A56F DEFW $A73B
 $A571 DEFW $A6D3
 $A573 DEFW $A75B
 $A575 DEFW $A780
 $A577 DEFW $A63A
 $A579 DEFW $A78E
 $A57B DEFW $A68C
 $A57D DEFW $A793
 $A57F DEFW $A7AC
 $A581 DEFW $A65C
 $A583 DEFW $A7B4
 $A585 DEFW $A694
 $A587 DEFW $A69C
 $A589 DEFW $A6A4
 $A58B DEFW $A6AC
 $A58D DEFW $A360
 $A58F DEFW $A771
 $A591 DEFW $A684
 $A593 DEFW $A852
 $A595 DEFW $A682
 $A597 DEFW $A63F
 $A599 DEFW $A643
 $A59B DEFW $A65A

; Puntatore agli argomenti sullo stack
b$A59D DEFB $00,$00

; Interprete pubblico con argomenti sullo stack
;
; Preserva BC, DE, IX, AF; usa HL per l'indirizzo del testo. Memorizza in $A59D
; la posizione degli argomenti oltre l'indirizzo di ritorno. Alla fine
; ripristina i registri, recupera il ritorno e aggiusta SP per consumare gli
; argomenti. La convenzione completa dei singoli comandi resta da documentare.
c$A59F PUSH BC       ;
 $A5A0 PUSH DE       ;
 $A5A1 PUSH IX       ;
 $A5A3 PUSH AF       ;
 $A5A4 PUSH HL       ;
 $A5A5 LD HL,$000C   ;
 $A5A8 ADD HL,SP     ;
 $A5A9 LD ($A59D),HL ;
 $A5AC POP HL        ;
 $A5AD LD A,($A00B)  ;
 $A5B0 AND A         ;
 $A5B1 JR NZ,$A5B6   ;
 $A5B3 LD ($A00C),A  ;
*$A5B6 CALL $A5C4    ;
 $A5B9 POP AF        ;
 $A5BA POP IX        ;
 $A5BC POP DE        ;
 $A5BD POP BC        ;
 $A5BE POP HL        ;
 $A5BF LD SP,($A59D) ;

; Salto indiretto tramite HL
;
; Used by the routine at #R$A5CD.
c$A5C3 JP (HL)       ;

; Interpreta una sequenza di token con inizio in HL
;
; IX diventa il cursore. Ripete $A5CD finche Z e zero; un comando terminale
; restituisce Z impostato. Per sequenze senza argomenti dinamici e utilizzabile
; direttamente, come nella prova a $6859.
c$A5C4 PUSH HL       ;
 $A5C5 POP IX        ;
*$A5C7 CALL $A5CD    ;
 $A5CA JR NZ,$A5C7   ;
 $A5CC RET           ;

; Decodifica e dispatch di un token
;
; Con bit 7 impostato: token lungo a due byte; D=primo byte AND $7F, E=secondo
; byte. I 12 bit bassi sono l'offset del dizionario, i bit 12-14 selezionano il
; contesto. I contesti $20/$30/$60 terminano la sequenza dopo la parola e
; passano da $A647.
c$A5CD LD A,(IX+$00) ;
 $A5D0 BIT 7,A       ;
 $A5D2 JR Z,$A5F2    ;
 $A5D4 AND $7F       ;
 $A5D6 LD D,A        ;
 $A5D7 LD E,(IX+$01) ;
 $A5DA INC IX        ;
 $A5DC AND $F0       ;
 $A5DE CP $30        ;
 $A5E0 JR Z,$A647    ;
 $A5E2 CP $20        ;
 $A5E4 JR Z,$A647    ;
 $A5E6 CP $60        ;
 $A5E8 JR Z,$A647    ;
; This entry point is used by the routine at #R$A83A.
*$A5EA CALL $A887    ;
*$A5ED INC IX        ;
 $A5EF OR $01        ;
 $A5F1 RET           ;
*$A5F2 CP $20        ; {Token sotto $20: comando tramite tabella $A55D.
 $A5F4 JR C,$A621    ; }
 $A5F6 CP $60        ; {Token $60-$7F: parola frequente tramite $A83A/$A840.
 $A5F8 JP NC,$A83A   ; }
 $A5FB CP $40        ; {Token $40-$5F: (token AND $1F)+1 caratteri a 5 bit
 $A5FD JR C,$A61C    ; immediatamente successivi.
 $A5FF AND $1F       ;
 $A601 INC A         ;
 $A602 LD B,A        ;
 $A603 PUSH IX       ;
 $A605 POP HL        ;
 $A606 INC HL        ;
 $A607 LD C,$00      ; }
*$A609 CALL $A990    ; {Legge un carattere a 5 bit e lo invia al buffer di
 $A60C CALL $A9B7    ; uscita.
 $A60F DJNZ $A609    ; }
 $A611 PUSH HL       ; {Aggiorna IX dopo i byte compatti, tenendo conto
 $A612 POP IX        ; dell'allineamento.
 $A614 LD A,C        ;
 $A615 AND A         ;
 $A616 JR NZ,$A5ED   ;
 $A618 DEC IX        ;
 $A61A JR $A5ED      ; }
*$A61C CALL $A9B7    ; {Token $20-$3F: carattere letterale.
 $A61F JR $A5ED      ; }
*$A621 PUSH DE       ; {Selezione della routine del comando (2 byte per
 $A622 LD E,A        ; indirizzo).
 $A623 LD D,$00      ;
 $A625 LD HL,$A55D   ;
 $A628 ADD HL,DE     ;
 $A629 ADD HL,DE     ;
 $A62A LD E,(HL)     ;
 $A62B INC HL        ;
 $A62C LD D,(HL)     ;
 $A62D EX DE,HL      ;
 $A62E POP DE        ; }
 $A62F CP $1D        ; {Comandi $1D-$1F sono terminali e ricevono un salto
 $A631 JR NC,$A5C3   ; diretto; gli altri vengono chiamati.
 $A633 CALL $A5C3    ;
 $A636 JR Z,$A5ED    ;
 $A638 JR $A5EA      ; }

; Comando che emette A e restituisce Z impostato
c$A63A CALL $A9B7    ;
 $A63D XOR A         ;
 $A63E RET           ;

; Terminazione con ritorno a capo (contesto $60)
c$A63F LD D,$60      ;
 $A641 JR $A64A      ;

; Terminazione con punto e ritorno a capo (contesto $30)
c$A643 LD D,$30      ;
 $A645 JR $A64A      ;

; Stampa la parola finale e applica la terminazione
;
; $20: solo fine; $30: punto e CR; $60: CR. I comandi $1D e $1E entrano
; rispettivamente da $A63F e $A643, senza stampare una parola.
c$A647 CALL $A887    ;
; This entry point is used by the routines at #R$A63F and #R$A643.
*$A64A LD A,$2E      ;
 $A64C BIT 6,D       ;
 $A64E JR NZ,$A657   ;
 $A650 BIT 4,D       ;
 $A652 CALL NZ,$A9B7 ;
 $A655 BIT 4,D       ;
*$A657 CALL NZ,$A2A2 ;
 $A65A XOR A         ;
 $A65B RET           ;

i$A65C

; Token compatto di parola frequente
;
; Used by the routine at #R$A5CD.
c$A83A CALL $A840    ;
 $A83D JP $A5EA      ;

; Risoluzione della parola frequente
;
; A-$60 seleziona una delle 32 word a $67B7. Restituisce DE con offset e
; contesto $5000. Questo ingresso da solo non stampa.
c$A840 SUB $60       ;
 $A842 LD E,A        ;
 $A843 LD D,$00      ;
 $A845 LD HL,$67B7   ;
 $A848 ADD HL,DE     ;
 $A849 ADD HL,DE     ;
 $A84A LD E,(HL)     ;
 $A84B INC HL        ;
 $A84C LD A,(HL)     ;
 $A84D ADD A,$50     ;
 $A84F LD D,A        ;
 $A850 RET           ;

; Stato di forzatura delle maiuscole
b$A851 DEFB $00

; Alterna $A851 tra 0 e 1
c$A852 LD A,($A851)  ;
 $A855 XOR $01       ;
 $A857 LD ($A851),A  ;
 $A85A XOR A         ;
 $A85B RET           ;

; Nove suffissi da quattro byte ciascuno
;
; S, ES, IES, backspace+IES, D, ING, ED, backspace+ING, LY. Gli zeri sono
; riempimento. $08 viene interpretato come arretramento nel buffer parola da
; $A9B7.
b$A85C DEFB $53,$00,$00,$00
 $A860 DEFB $45,$53,$00,$00
 $A864 DEFB $49,$45,$53,$00
 $A868 DEFB $08,$49,$45,$53
 $A86C DEFB $44,$00,$00,$00
 $A870 DEFB $49,$4E,$47,$00
 $A874 DEFB $45,$44,$00,$00
 $A878 DEFB $08,$49,$4E,$47
 $A87C DEFB $4C,$59,$00,$00

; Legge un riferimento dal puntatore HL e azzera il nibble di contesto
;
; Legge prima il byte basso, poi quello alto; avanza HL di due. A887 riceve
; solo i 12 bit bassi del riferimento.
c$A880 LD E,(HL)     ;
 $A881 INC HL        ;
 $A882 LD A,(HL)     ;
 $A883 INC HL        ;
 $A884 AND $0F       ;
 $A886 LD D,A        ;

; Ricostruisce ed emette una voce del dizionario
;
; Non emette nulla se $5C3C e zero o l'offset e zero. Conserva IX, HL, BC, DE
; sul percorso normale. Inserisce uno spazio prima della voce. Trova il gruppo
; alfabetico nell'indice $5D80, emette l'iniziale implicita e decodifica
; sequenzialmente i record del gruppo fino all'offset richiesto. Applica poi
; l'eventuale suffisso e invia il resto della parola a $A9B7.
;
; DE Offset a 12 bit e contesto nel nibble alto.
c$A887 LD A,($5C3C)  ;
 $A88A AND A         ;
 $A88B RET Z         ;
 $A88C LD ($A022),DE ;
 $A890 LD A,D        ;
 $A891 AND $0F       ;
 $A893 OR E          ;
 $A894 RET Z         ;
 $A895 PUSH IX       ;
 $A897 PUSH HL       ;
 $A898 PUSH BC       ;
 $A899 PUSH DE       ;
 $A89A LD A,$20      ;
 $A89C CALL $A9B7    ;
 $A89F LD A,D        ;
 $A8A0 AND $F0       ;
 $A8A2 LD C,A        ;
 $A8A3 CP $70        ; {Contesto $70: imposta $A026 per rendere maiuscola la
 $A8A5 LD A,$01      ; prossima lettera.
 $A8A7 JR NZ,$A8AC   ;
 $A8A9 LD ($A026),A  ;
*$A8AC LD A,D        ;
 $A8AD AND $0F       ;
 $A8AF LD D,A        ;
 $A8B0 EX DE,HL      ;
 $A8B1 PUSH HL       ;
 $A8B2 LD A,H        ;
 $A8B3 OR C          ;
 $A8B4 LD H,A        ;
 $A8B5 LD ($A022),HL ;
 $A8B8 POP HL        ;
 $A8B9 PUSH BC       ; }
 $A8BA LD IX,$5D80   ; {Indice alfabetico, confrontato con l'offset richiesto.
 $A8BE LD B,$5F      ;
*$A8C0 INC B         ;
 $A8C1 LD A,(IX+$01) ;
 $A8C4 CP H          ;
 $A8C5 JR C,$A8CF    ;
 $A8C7 JR NZ,$A8D9   ;
 $A8C9 LD A,(IX+$00) ;
 $A8CC CP L          ;
 $A8CD JR NC,$A8D9   ;
*$A8CF INC IX        ;
 $A8D1 INC IX        ;
 $A8D3 LD A,B        ;
 $A8D4 CP $7B        ;
 $A8D6 JR NZ,$A8C0   ;
 $A8D8 INC B         ;
*$A8D9 JR Z,$A8E0    ;
*$A8DB DEC IX        ;
 $A8DD DEC IX        ;
 $A8DF DEC B         ;
*$A8E0 LD E,(IX+$00) ;
 $A8E3 LD D,(IX+$01) ;
 $A8E6 LD A,D        ;
 $A8E7 OR E          ;
 $A8E8 JR Z,$A8DB    ; }
 $A8EA LD A,B        ; {Emette l'iniziale ricostruita dal numero del gruppo.
 $A8EB CALL $A9B7    ; }
 $A8EE LD BC,$5DBF   ; {Base relativa $5DBF: converte offset in indirizzi RAM.
 $A8F1 ADD HL,BC     ;
 $A8F2 PUSH HL       ;
 $A8F3 EX DE,HL      ;
 $A8F4 ADD HL,BC     ; }
*$A8F5 PUSH HL       ; {Decodifica record successivi finche arriva al record
 $A8F6 AND A         ; richiesto.
 $A8F7 SBC HL,DE     ;
 $A8F9 POP HL        ;
 $A8FA PUSH AF       ;
 $A8FB CALL $A95B    ;
 $A8FE POP AF        ;
 $A8FF JR NZ,$A8F5   ;
 $A901 POP HL        ;
 $A902 POP BC        ; }
 $A903 LD A,C        ; {Contesto $50: nessuna desinenza; $40: desinenza
 $A904 CP $50        ; obbligatoria; $10: dipende da $A034; gli altri dipendono
 $A906 JR Z,$A91C    ; da $A036.
 $A908 CP $40        ;
 $A90A JR Z,$A919    ;
 $A90C CP $10        ;
 $A90E LD A,($A034)  ;
 $A911 JR Z,$A916    ;
 $A913 LD A,($A036)  ;
*$A916 AND A         ;
 $A917 JR Z,$A91C    ;
*$A919 CALL $A92F    ; }
*$A91C LD HL,$5C42   ; {Emette il buffer terminato da zero a $5C42.
*$A91F LD A,(HL)     ;
 $A920 AND A         ;
 $A921 JR Z,$A929    ;
 $A923 CALL $A9B7    ;
 $A926 INC HL        ;
 $A927 JR $A91F      ;
*$A929 POP DE        ;
 $A92A POP BC        ;
 $A92B POP HL        ;
 $A92C POP IX        ;
 $A92E RET           ; }

; Appende il suffisso indicato dal record
;
; HL punta al primo byte del record e IX alla fine del buffer. Nibble basso $F:
; nessun suffisso. Altrimenti usa quattro byte da $A85C+4*nibble e aggiunge un
; terminatore zero. Nel dizionario presente gli indici sono soltanto 0-8 oppure
; $F.
c$A92F LD A,(HL)     ;
 $A930 AND $0F       ;
 $A932 CP $0F        ;
 $A934 RET Z         ;
 $A935 RLCA          ;
 $A936 RLCA          ;
 $A937 LD L,A        ;
 $A938 LD H,$00      ;
 $A93A LD BC,$A85C   ;
 $A93D ADD HL,BC     ;
 $A93E LD B,$04      ;
*$A940 LD A,(HL)     ;
 $A941 INC HL        ;
 $A942 LD (IX+$00),A ;
 $A945 INC IX        ;
 $A947 DJNZ $A940    ;
 $A949 LD (IX+$00),B ;
 $A94C RET           ;

; Decodifica un record e applica il suo suffisso
c$A94D PUSH IX       ;
 $A94F PUSH HL       ;
 $A950 CALL $A95B    ;
 $A953 EX (SP),HL    ;
 $A954 CALL $A92F    ;
 $A957 POP HL        ;
 $A958 POP IX        ;
 $A95A RET           ;

; Decodifica il resto di una voce con riuso di prefisso
;
; Usa il buffer precedente a $5C42. Byte 1: bit 7 fa saltare due byte
; aggiuntivi; bit 4-6 indicano quanti caratteri precedenti conservare; bit 0-3
; indicano quanti nuovi caratteri a 5 bit leggere. La prima lettera del gruppo
; non e nel buffer. Restituisce HL al record successivo e IX sul terminatore.
; Conserva BC. La natura dei due byte aggiuntivi non e ancora identificata.
;
; HL Indirizzo del primo byte del record.
c$A95B PUSH BC         ;
 $A95C LD IX,$5C42     ;
 $A960 INC HL          ; Salta il byte 0, contenente fra l'altro l'indice di
                       ; suffisso.
 $A961 LD A,(HL)       ; {Legge il descrittore del record.
 $A962 BIT 7,A         ;
 $A964 INC HL          ;
 $A965 JR Z,$A969      ;
 $A967 INC HL          ;
 $A968 INC HL          ; }
*$A969 PUSH AF         ; {Conserva il prefisso del buffer precedente facendo
 $A96A AND $70         ; avanzare IX.
 $A96C JR Z,$A974      ;
*$A96E INC IX          ;
 $A970 SUB $10         ;
 $A972 JR NZ,$A96E     ; }
*$A974 LD C,$00        ; {C e il cursore di bit, inizialmente zero.
 $A976 POP AF          ;
 $A977 AND $0F         ;
 $A979 JR Z,$A986      ;
 $A97B LD B,A          ; }
*$A97C CALL $A990      ; {Estrae i nuovi caratteri e li scrive nel buffer.
 $A97F LD (IX+$00),A   ;
 $A982 INC IX          ;
 $A984 DJNZ $A97C      ; }
*$A986 LD (IX+$00),$00 ; {Terminatore zero.
 $A98A LD A,C          ;
 $A98B POP BC          ; }
 $A98C AND A           ; {Se restano bit parziali, avanza al byte successivo.
 $A98D RET Z           ;
 $A98E INC HL          ;
 $A98F RET             ; }

; Estrae un carattere da un flusso a 5 bit
;
; Legge una finestra di due byte, la allinea al cursore C, prende cinque bit e
; aggiunge $60. A restituisce il carattere. HL e C avanzano di cinque bit; DE
; viene preservato.
;
; HL Puntatore al byte corrente.
; C Offset di bit nel byte (0-7), MSB per primo.
c$A990 PUSH DE       ;
 $A991 LD D,(HL)     ;
 $A992 INC HL        ;
 $A993 LD E,(HL)     ;
 $A994 DEC HL        ;
 $A995 LD A,C        ;
 $A996 AND A         ;
 $A997 JR Z,$A9A0    ;
*$A999 SLA E         ;
 $A99B RL D          ;
 $A99D DEC A         ;
 $A99E JR NZ,$A999   ;
*$A9A0 LD A,C        ;
 $A9A1 ADD A,$05     ;
 $A9A3 CP $08        ;
 $A9A5 JR C,$A9AA    ;
 $A9A7 SUB $08       ;
 $A9A9 INC HL        ;
*$A9AA LD C,A        ;
 $A9AB LD A,D        ;
 $A9AC POP DE        ;
 $A9AD RRCA          ;
 $A9AE RRCA          ;
 $A9AF RRCA          ;
 $A9B0 AND $1F       ;
 $A9B2 ADD A,$60     ;
 $A9B4 RET           ;

; Puntatore corrente del buffer parola (base $5C0B)
w$A9B5 DEFW $5C0B

; Buffer parola e a capo senza spezzare le parole
;
; Con $A027 diverso da zero salta direttamente a $C1E1. Nel percorso normale
; accoda il carattere; $08 arretra il puntatore. Spazio, CR e virgoletta
; svuotano il buffer: confronta la lunghezza con le colonne rimaste in $C1F5 ed
; eventualmente emette prima un CR. Poi invia i caratteri e il delimitatore a
; $AA14.
;
; A Carattere da accodare.
c$A9B7 PUSH AF       ;
 $A9B8 LD A,($A027)  ;
 $A9BB AND A         ;
 $A9BC JR NZ,$AA10   ;
 $A9BE POP AF        ;
 $A9BF PUSH AF       ;
 $A9C0 PUSH HL       ;
 $A9C1 LD HL,($A9B5) ;
 $A9C4 CP $20        ;
 $A9C6 JR Z,$A9DF    ;
 $A9C8 CP $0D        ;
 $A9CA JR Z,$A9DF    ;
 $A9CC CP $22        ;
 $A9CE JR Z,$A9DF    ;
 $A9D0 CP $08        ;
 $A9D2 JR NZ,$A9D7   ;
 $A9D4 DEC HL        ;
 $A9D5 JR $A9D9      ;
*$A9D7 LD (HL),A     ;
 $A9D8 INC HL        ;
*$A9D9 LD ($A9B5),HL ;
 $A9DC POP HL        ;
 $A9DD POP AF        ;
 $A9DE RET           ;
*$A9DF PUSH DE       ;
 $A9E0 LD DE,$5C0B   ;
 $A9E3 AND A         ;
 $A9E4 SBC HL,DE     ;
 $A9E6 JR Z,$AA0B    ;
 $A9E8 LD A,($C1F5)  ;
 $A9EB CP L          ;
 $A9EC PUSH AF       ;
 $A9ED JR NC,$A9F4   ;
 $A9EF LD A,$0D      ;
 $A9F1 CALL $AA14    ;
*$A9F4 PUSH BC       ;
 $A9F5 LD B,L        ;
 $A9F6 LD HL,$5C0B   ;
 $A9F9 LD ($A9B5),HL ;
*$A9FC LD A,(HL)     ;
 $A9FD CALL $AA14    ;
 $AA00 INC HL        ;
 $AA01 DJNZ $A9FC    ;
 $AA03 POP BC        ;
 $AA04 POP AF        ;
 $AA05 JR NZ,$AA0B   ;
 $AA07 XOR A         ;
 $AA08 LD ($A025),A  ;
*$AA0B POP DE        ;
 $AA0C POP HL        ;
 $AA0D POP AF        ;
 $AA0E JR $AA14      ;
