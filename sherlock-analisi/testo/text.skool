 $AA5C AND A         ;
 $AA5D JR NZ,$AA65   ;
 $AA5F LD A,($A026)  ;
 $AA62 AND A         ;
 $AA63 JR Z,$AA6D    ;
*$AA65 XOR A         ;
 $AA66 LD ($A026),A  ;
 $AA69 POP AF        ;
 $AA6A AND $5F       ;
 $AA6C PUSH AF       ;
*$AA6D POP AF        ;
 $AA6E JP $C1E1      ;

