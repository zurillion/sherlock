{"input":"S","clock":{"tick":162,"due":162,"day":0,"minute":41,"hour":10,"period":"am","label":"Mon 10:41am"},"room":93,"outcome":"ok","notice":null,"text":["You go south.","You are at Jones Front Door. To the south there is the front door. Visible exits are north.","Watson enters."],"actors":[{"id":2,"room":76},{"id":3,"room":93},{"id":6,"room":67},{"id":13,"room":0},{"id":95,"room":0}],"facts":[{"start":"9965","flags":165,"terms":[1543,36195,0,2048]},{"start":"9973","flags":164,"terms":[46,16441,93,2141]},{"start":"9981","flags":164,"terms":[72,16450,67,16451,0,0,0,2048]},{"start":"9997","flags":164,"terms":[87,16472,90,16467,81,18513]},{"start":"99a9","flags":164,"terms":[0,0,85,16469,0,2560]}],"ending":null}
