{"input":"WAIT","clock":{"tick":150,"due":150,"day":0,"minute":29,"hour":10,"period":"am","label":"Mon 10:29am"},"room":54,"outcome":"ok","notice":null,"text":["You wait.","You are in a steam train with Inspector Lestrade and Watson. Inspector Lestrade is carrying some money. Watson is carrying the daily chronicle. You are at platform one of Leather Head station. Visible exits are south north."],"actors":[{"id":2,"room":54},{"id":3,"room":54},{"id":6,"room":67},{"id":13,"room":0},{"id":95,"room":0}],"facts":[{"start":"9965","flags":165,"terms":[1543,36195,0,2048]},{"start":"9973","flags":164,"terms":[46,16441,93,2141]},{"start":"9981","flags":164,"terms":[72,16450,67,16451,0,0,0,2048]},{"start":"9997","flags":164,"terms":[87,16472,90,16467,81,18513]},{"start":"99a9","flags":164,"terms":[0,0,85,16469,0,2560]}],"ending":null}
